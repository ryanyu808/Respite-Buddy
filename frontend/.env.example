# Leave blank for local Vite proxying. Set to the public Render URL in Vercel.
VITE_API_BASE_URL=
# Optional public Microsoft SPA application ID (never a client secret).
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common
# Optional public Google OAuth web client ID, never a client secret.
VITE_GOOGLE_CLIENT_ID=

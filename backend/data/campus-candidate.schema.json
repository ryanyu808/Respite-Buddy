{
  "$defs": {
    "AttributeEvidence": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^https://[^\\s/]+(?:/[^\\s]*)?$",
          "title": "Url",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        }
      },
      "required": [
        "url",
        "checked"
      ],
      "title": "AttributeEvidence",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "USC primary source",
            "USC historical article",
            "OpenStreetMap snapshot"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "url",
        "source_type",
        "checked",
        "supports"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HoursInterval": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "HoursInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "building": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Building"
    },
    "building_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Building Code"
    },
    "floor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Floor"
    },
    "lat": {
      "maximum": 34.032,
      "minimum": 34.01,
      "title": "Lat",
      "type": "number"
    },
    "lng": {
      "maximum": -118.277,
      "minimum": -118.298,
      "title": "Lng",
      "type": "number"
    },
    "photo_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Photo Url"
    },
    "indoor": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Indoor"
    },
    "hours": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/HoursInterval"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hours"
    },
    "access": {
      "anyOf": [
        {
          "enum": [
            "open",
            "usc_id",
            "restricted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Access"
    },
    "access_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Access Note"
    },
    "lighting": {
      "anyOf": [
        {
          "enum": [
            "bright",
            "medium",
            "dim"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lighting"
    },
    "noise": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Noise"
    },
    "seating": {
      "anyOf": [
        {
          "enum": [
            "none",
            "hard",
            "soft"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Seating"
    },
    "typical_crowd": {
      "anyOf": [
        {
          "enum": [
            "few",
            "some",
            "many"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Typical Crowd"
    },
    "outlets": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outlets"
    },
    "food_allowed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Food Allowed"
    },
    "restroom_nearby": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Restroom Nearby"
    },
    "step_free": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Step Free"
    },
    "safe_after_dark": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Safe After Dark"
    },
    "verified_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified By"
    },
    "verified_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified Date"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notes"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "data_kind": {
      "const": "mapped",
      "default": "mapped",
      "title": "Data Kind",
      "type": "string"
    },
    "purpose": {
      "default": "general",
      "enum": [
        "general",
        "prayer",
        "lactation",
        "other_dedicated"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "food_available": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Food Available"
    },
    "venue_kind": {
      "anyOf": [
        {
          "enum": [
            "cafe",
            "dining_hall",
            "food_market",
            "outdoor_eating",
            "seating_only"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue Kind"
    },
    "reservation_required": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reservation Required"
    },
    "evidence": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AttributeEvidence"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "routing_anchor": {
      "title": "Routing Anchor",
      "type": "string"
    },
    "anchor_source": {
      "title": "Anchor Source",
      "type": "string"
    },
    "amenities": {
      "items": {
        "type": "string"
      },
      "title": "Amenities",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "building",
    "building_code",
    "floor",
    "lat",
    "lng",
    "photo_url",
    "indoor",
    "hours",
    "access",
    "access_note",
    "lighting",
    "noise",
    "seating",
    "typical_crowd",
    "outlets",
    "food_allowed",
    "restroom_nearby",
    "step_free",
    "safe_after_dark",
    "verified_by",
    "verified_date",
    "notes",
    "source_url",
    "reservation_required",
    "provenance",
    "routing_anchor",
    "anchor_source",
    "amenities"
  ],
  "title": "CampusCandidate",
  "type": "object"
}

# Copy to .env at the repository root. Leave blank for deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WALKING_SPEED_KPH=4.8
# Optional Overpass mirror, e.g. https://overpass.kumi.systems/api
OVERPASS_URL=https://overpass-api.de/api
FRONTEND_URL=http://localhost:5173
# Optional public origin for links returned by the recommendation engine and MCP.
WEBSITE_URL=https://neuro-route-nine.vercel.app
